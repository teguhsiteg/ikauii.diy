rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // FUNGSI BANTU
    // ============================================================
    function isLoggedIn() {
      return request.auth != null;
    }

    // Admin = user terdaftar di collection users — dicari via UID ATAU email.
    // (admin_emails TIDAK dipakai lagi — semua lewat users saja)
    function isAdmin() {
      return isLoggedIn() && (
        // Check by UID
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).exists &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "super_admin", "superadmin", "koordinator"]
        ) || (
          // Check by EMAIL (legacy — dokumen users di-key oleh email)
          request.auth.token.email != null &&
          get(/databases/$(database)/documents/users/$(request.auth.token.email)).exists &&
          get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role in ["admin", "super_admin", "superadmin", "koordinator"]
        )
      );
    }

    // Pemilik dokumen (jika dokumen menyimpan field uid)
    function isOwner() {
      return isLoggedIn() && resource.data.uid == request.auth.uid;
    }

    // Pemilik dokumen via field email
    function isOwnerByEmail() {
      return isLoggedIn()
        && request.auth.token.email != null
        && resource.data.email == request.auth.token.email;
    }

    // ============================================================
    // FORM PUBLIK — create tanpa login, update/delete pemilik atau admin
    // ============================================================
    match /pendaftaran_bisnis/{docId} {
      allow read, create: if true;
      allow update, delete: if isAdmin() || isOwner();
    }
    match /pendaftaran_iklan/{docId} {
      allow read, create: if true;
      allow update, delete: if isAdmin() || isOwner();
    }
    match /agenda_peserta/{docId} {
      allow read, create: if true;
      allow update, delete: if isAdmin() || isOwner();
    }
    match /agenda_donasi/{docId} {
      allow read, create: if true;
      allow update, delete: if isAdmin() || isOwner();
    }
    match /twibbon_logs/{docId} {
      allow read, create: if true;
      allow update, delete: if isAdmin() || isOwner();
    }
    match /offline_participants/{docId} {
      allow read, create: if true;
      allow update, delete: if isAdmin() || isOwner();
    }

    // ============================================================
    // VIRTUAL RUN — paling sensitif (pembayaran & BIB)
    // ============================================================
    match /vr_participants/{docId} {
      allow read: if true;

      allow create: if true
        && request.resource.data.statusPembayaran == "Pending"
        && request.resource.data.nama is string
        && request.resource.data.email is string
        && request.resource.data.jarak is string
        && request.resource.data.paket is string
        && request.resource.data.totalTagihan is number;

      allow update: if isAdmin() || (
        isLoggedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "snapToken",
          "buktiBayarUrl"
        ])
      );

      allow delete: if isAdmin();
    }

    match /vr_submissions/{docId} {
      allow read: if isLoggedIn();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /vr_logs/{docId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ============================================================
    // KONTEN PUBLIK — read bebas, tulis admin
    // ============================================================
    match /berita/{docId}         { allow read: if true; allow write: if isAdmin(); }
    match /pengaturan/{docId}     { allow read: if true; allow write: if isAdmin(); }
    match /settings/{docId}       { allow read: if true; allow write: if isAdmin(); }
    match /pengurus/{docId}       { allow read: if true; allow write: if isAdmin(); }
    match /dpd/{docId}            { allow read: if true; allow write: if isAdmin(); }
    match /direktori_bisnis/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /iklan_direktori/{docId}  { allow read: if true; allow write: if isAdmin(); }
    match /agenda/{docId}         { allow read: if true; allow write: if isAdmin(); }
    match /galeri/{docId}         { allow read: if true; allow write: if isAdmin(); }
    match /kuis/{docId}           { allow read: if true; allow write: if isAdmin(); }

    match /feedbacks/{docId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // ============================================================
    // DATA PRIBADI ALUMNI — admin full, pemilik baca sendiri
    // ============================================================
    match /pendaftar/{docId} {
      allow read: if isAdmin() || (
        isLoggedIn() && request.auth.uid == docId
      );
      // Create via public registration form — server-side via firebase-admin
      allow create: if true;
      allow update: if isAdmin() || (
        isLoggedIn() && request.auth.uid == docId
      );
      allow delete: if isAdmin();
    }

    // ============================================================
    // OPEN RECRUITMENT — admin only
    // ============================================================
    match /oprec_periode/{docId}    { allow read, write: if isAdmin(); }
    match /oprec_pendaftar/{docId}  { allow read, write: if isAdmin(); }
    match /oprec_divisi/{docId}     { allow read, write: if isAdmin(); }

    // ============================================================
    // PROGRAM KERJA — internal, admin only
    // ============================================================
    match /proker/{docId} { allow read, write: if isAdmin(); }

    // ============================================================
    // DONASI — admin write, logged-in read (riwayat donasi publik)
    // ============================================================
    match /donasi_logs/{docId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }
    match /donasi_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // MASTERCLASS — admin + pemilik (student)
    // ============================================================
    match /masterclass_enrollments/{docId} {
      allow read: if isAdmin() || isOwnerByEmail();
      // Create/update via server route (midtrans webhook) — client tidak bisa
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /masterclass_courses/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /masterclass_materials/{docId} {
      allow read: if isAdmin() || isOwnerByEmail();
      allow write: if isAdmin();
    }

    // ============================================================
    // VALIDASI TTD — read publik (QR scan), write admin
    // ============================================================
    match /validasi_ttd/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // ADMIN EMAILS — hanya admin & server
    // ============================================================
    match /admin_emails/{email} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // USERS — privasi: tulis hanya doc sendiri, admin bebas
    // USERS — privasi: akses via UID, email, atau admin.
    // NOTE: beberapa dokumen di-key oleh EMAIL (legacy), bukan UID.
    match /users/{uid} {
      allow read: if isLoggedIn() && (
        request.auth.uid == uid ||
        request.auth.token.email == uid ||
        isAdmin()
      );
      allow create: if isLoggedIn() && request.auth.uid == uid;
      allow update: if isLoggedIn() && (
        request.auth.uid == uid ||
        request.auth.token.email == uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ============================================================
    // CATCH-ALL — sisa koleksi internal: read (login), write ADMIN ONLY.
    // Mencakup: nomor_surat, surat_edaran, kuitansi_organisasi,
    // doorprize_items, promo_codes, system, templates, bidang, periode,
    // merchandise, crew_volunteers, peserta, merchandise_usulan, dll.
    //
    // ⚠️  Aturan: setiap koleksi baru yang menyimpan data sensitif HARUS
    //     punya rules eksplisit di atas, jangan mengandalkan catch-all.
    // ============================================================
    match /{document=**} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }
  }
}
