rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- PUBLIC READ + PUBLIC WRITE ---
    // Collection yang diisi dari form publik (pendaftaran, donasi, twibbon)
    match /pendaftaran_bisnis/{docId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
    match /pendaftaran_iklan/{docId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
    match /agenda_peserta/{docId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
    match /agenda_donasi/{docId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
    match /twibbon_logs/{docId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
    match /vr_participants/{docId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }
    match /vr_submissions/{docId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }
    match /offline_participants/{docId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }


    // --- PUBLIC READ ONLY ---
    match /berita/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /pengaturan/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /pengurus/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /dpd/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /direktori_bisnis/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /iklan_direktori/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /agenda/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /galeri/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /feedbacks/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // --- AUTHENTICATED ONLY ---
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
