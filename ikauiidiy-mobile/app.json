{
  "expo": {
    "name": "IKA UII DIY",
    "slug": "ikauiidiy-mobile",
    "version": "1.0.0",
    "scheme": "ikauiidiy",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#152B5B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ikauiidiy.mobile"
    },
    "android": {
      "package": "com.ikauiidiy.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikasi membutuhkan akses kamera untuk memindai QR Code verifikasi dokumen, e-KTA, dan donasi.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
